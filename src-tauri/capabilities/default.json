  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:default",
    "dialog:default",
    "allow-library-info",
    "allow-list-recipes",
    "allow-reveal-library",
    "allow-import-recipe",
    "allow-open-import-browser",
    "allow-import-page-html",
    "allow-get-recipe",
    "allow-update-recipe",
    "allow-delete-recipe",
    "allow-add-image-from-file",
    "allow-set-hero",
    "allow-remove-image",
    "allow-print-page"
  ]
}
